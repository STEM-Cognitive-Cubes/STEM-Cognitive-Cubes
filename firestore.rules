rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPlaySessionData() {
      return request.resource.data.keys().hasAll(["parentId", "status"])
        && request.resource.data.parentId is string
        && request.resource.data.parentId == request.auth.uid
        && request.resource.data.status is string;
    }

    match /users/{userId} {
      allow create, read, update, delete: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /parents/{userId} {
      allow create, read, update, delete: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /playSessions/{sessionId} {
      allow create: if isSignedIn()
        && isValidPlaySessionData();
      allow read, update, delete: if isSignedIn()
        && resource.data.parentId == request.auth.uid;
    }

    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
