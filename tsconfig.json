{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@assets/*": ["src/assets/*"]
    }
  },
  "include": ["App.tsx", "src/**/*", "tests/**/*", "jest.config.js"],
  "exclude": ["node_modules", "android", "ios"]
}
